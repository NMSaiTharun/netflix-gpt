# Copy to .env and fill in your own values.

# Firebase: Project settings > General > Your apps > SDK setup and config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# TMDB API Read Access Token 
VITE_TMDB_API_JWT_AUTH_TOKEN=

# No OpenAI key here as VITE_ values end up in the browser bundle,
# so it lives in the Azure function's settings instead.
